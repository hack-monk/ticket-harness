# Ticket harness settings. Copied to ~/.ticket-harness/config.env on first install.
# Values are model aliases or full model IDs, as accepted by `claude --model`.

LEAD_MODEL=opus        # brainstorming, planning, review. Set to fable if you have access.
CODER_MODEL=sonnet     # implementation
COMMS_MODEL=haiku      # Slack and email drafting
TRIAGE_MODEL=haiku     # sizes a ticket as small or large
STANDUP_MODEL=haiku    # writes the standup update

# Where ticket folders live. The default is the ticket-workspace skill's
# location, ~/Desktop/tickets. Change it only if you change the skill too;
# the two must point at the same place.
# TICKETS_ROOT="$HOME/Desktop/tickets"
